# GitHub Personal Access Token (for research module)
# Get one at: https://github.com/settings/tokens
# Required scope: public_repo (read-only access to public repositories)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub App (for app module)
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY_BASE64=base64-encoded-pem-here
GITHUB_WEBHOOK_SECRET=your-webhook-secret
